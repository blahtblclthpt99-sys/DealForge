{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dealforge",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "build": {
    "command": "node scripts/ensure-cloudflare-build.mjs"
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "AUTH_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET_TEST"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "NEXT_PUBLIC_APP_URL": "https://www.deal-forge.sale",
    "NEXT_PUBLIC_APP_NAME": "DealForge",
    "CHECKOUT_ALLOWED_SHIPPING_COUNTRIES": "US",
    "SHIPPING_ADDRESS_CAPTURE_CERTIFIED": "true",
    "STRIPE_AUTOMATIC_TAX_ENABLED": "true",
    "STRIPE_AUTOMATIC_TAX_E2E_CERTIFIED": "true",
    "INVENTORY_EVIDENCE_BINDING_REQUIRED": "true"
  },
  "observability": {
    "enabled": true
  }
}
