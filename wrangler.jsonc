{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dealforge",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "deal-forge.sale",
      "custom_domain": true
    },
    {
      "pattern": "www.deal-forge.sale",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["DATABASE_URL", "AUTH_SECRET", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
  },
  "build": {
    "command": "node scripts/ensure-cloudflare-build.mjs"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "NEXT_PUBLIC_APP_URL": "https://www.deal-forge.sale",
    "NEXT_PUBLIC_APP_NAME": "DealForge",
    "AMAZON_ASSOCIATE_TAG": "titanfieldos-20",
    "AMAZON_PARTNER_TAG": "titanfieldos-20"
  },
  "observability": {
    "enabled": true
  }
}
