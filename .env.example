# Database (SQLite for local; use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@dealforge.com"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# Stripe payments — Phase 2.5 financial gate
# Keep these server-side. Never expose these values through NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET_TEST="whsec_..."
STRIPE_WEBHOOK_SECRET_LIVE="whsec_..."
# Legacy single-secret fallback only; prefer the mode-specific names above.
STRIPE_WEBHOOK_SECRET=""

# Amazon Associates (legacy catalog/source metadata only)
AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_HOST="webservices.amazon.com"
AMAZON_REGION="us-east-1"

# eBay Partner Network
EBAY_AFFILIATE_SID=""
EBAY_AFFILIATE_TRACKING_ID=""

# AliExpress Affiliate / Portals
ALIEXPRESS_AFF_SHORT_KEY=""
ALIEXPRESS_PUBLISHER_ID=""

# Optional Redis (falls back to in-memory cache)
REDIS_URL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DealForge"
