# Database (SQLite for local; use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Destructive seed guard. Local SQLite is allowed without this confirmation.
# Never set this against a shared/production database unless an intentional full reset is approved.
ALLOW_DESTRUCTIVE_SEED=""

# Auth
# Local development may leave this empty and uses a development-only fallback.
# Production fails closed unless AUTH_SECRET contains at least 32 unpredictable characters.
AUTH_SECRET=""
# Optional but recommended: use a distinct internal maintenance token (24+ random characters).
# If omitted, DealForge derives a one-way maintenance credential from a valid production AUTH_SECRET.
MAINTENANCE_TOKEN=""
# Required explicitly for protected/non-local seed operations. Local SQLite may use the local-only seed fallback.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Demo shoppers are never seeded unless this is explicitly enabled and credentials are supplied.
SEED_DEMO_USER="false"
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""

# Stripe payments — Phase 2.5 financial gate
# Keep these server-side. Never expose these values through NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET_TEST="whsec_..."
STRIPE_WEBHOOK_SECRET_LIVE="whsec_..."
# Legacy single-secret fallback only; prefer the mode-specific names above.
STRIPE_WEBHOOK_SECRET=""

# Amazon Associates (legacy catalog/source metadata only)
AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_HOST="webservices.amazon.com"
AMAZON_REGION="us-east-1"

# eBay Partner Network
EBAY_AFFILIATE_SID=""
EBAY_AFFILIATE_TRACKING_ID=""

# AliExpress Affiliate / Portals
ALIEXPRESS_AFF_SHORT_KEY=""
ALIEXPRESS_PUBLISHER_ID=""

# Optional Redis (falls back to in-memory cache)
REDIS_URL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DealForge"
