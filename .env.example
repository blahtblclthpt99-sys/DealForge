# Database (SQLite for local; use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@dealforge.com"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# Development seed only. Local SQLite creates the demo shopper by default.
# For an intentionally authorized non-SQLite reset, demo creation is opt-in and
# DEMO_PASSWORD must be explicitly set to a non-default value of at least 16 characters.
SEED_DEMO_USER="0"
DEMO_PASSWORD=""

# Amazon Associates (DealForge)
AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"

# Amazon Creators API (replaces legacy PA-API access/secret keys)
AMAZON_CREATORS_CREDENTIAL_ID=""
AMAZON_CREATORS_CREDENTIAL_SECRET=""
AMAZON_CREATORS_CREDENTIAL_VERSION="3.1"

# Google AdSense — use a real publisher ID (ca-pub-...), not a Google Ads customer ID.
ADSENSE_CLIENT=""
ADSENSE_SLOT_HOME_TOP=""
ADSENSE_SLOT_HOME_FEED=""
ADSENSE_SLOT_PRODUCT=""

# eBay Partner Network
EBAY_AFFILIATE_SID=""
EBAY_AFFILIATE_TRACKING_ID=""

# AliExpress Affiliate / Portals
ALIEXPRESS_AFF_SHORT_KEY=""
ALIEXPRESS_PUBLISHER_ID=""

# Optional Redis (falls back to in-memory cache)
REDIS_URL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DealForge"
