generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            String   @default("user")
  wishlist        String   @default("[]")
  savedSearches   String   @default("[]")
  recentlyViewed  String   @default("[]")
  priceAlerts     String   @default("[]")
  settings        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clicks          ClickEvent[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                 String   @id @default(cuid())
  asin               String?
  slug               String   @unique
  title              String
  description        String
  brand              String
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  subcategory        String?
  images             String
  quantity           Int?
  price              Float
  originalPrice      Float
  discountPercent    Float    @default(0)
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  affiliateUrl       String
  retailer           String   @default("amazon")
  availability       String   @default("in_stock")
  specifications     String   @default("{}")
  priceSource        String?
  priceVerifiedAt    DateTime?
  metadataSource     String?
  metadataVerifiedAt DateTime?
  trendingScore      Float    @default(0)
  clickCount         Int      @default(0)
  viewCount          Int      @default(0)
  isFeatured         Boolean  @default(false)
  isFlashDeal        Boolean  @default(false)
  flashEndsAt        DateTime?
  commerceEnabled    Boolean  @default(false)
  sellingPriceCents  Int?
  landedCostCents    Int?
  currency           String   @default("usd")
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  clicks         ClickEvent[]
  supplierOffers SupplierOffer[]

  @@index([categoryId])
  @@index([subcategory])
  @@index([asin])
  @@index([discountPercent])
  @@index([rating])
  @@index([trendingScore])
  @@index([createdAt])
  @@index([price])
  @@index([brand])
  @@index([isFeatured])
  @@index([isFlashDeal])
  @@index([commerceEnabled])
}

model Supplier {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  sourceClass        String
  websiteUrl         String?
  active             Boolean  @default(false)
  resaleAllowed      Boolean  @default(false)
  sourceVerifiedAt   DateTime?
  verificationSource String?
  metadata           String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  offers             SupplierOffer[]

  @@index([active])
  @@index([sourceClass])
  @@index([sourceVerifiedAt])
}

model SupplierOffer {
  id                     String   @id @default(cuid())
  offerKey               String   @unique
  supplierId             String
  supplier               Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId              String
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalOfferId        String?
  sourceUrl              String?
  active                 Boolean  @default(false)
  availability           String   @default("unknown")
  currency               String   @default("usd")
  itemCostCents          Int
  shippingCents          Int      @default(0)
  taxCents               Int      @default(0)
  supplierFeeCents       Int      @default(0)
  handlingCents          Int      @default(0)
  priceVerifiedAt        DateTime?
  inventoryConfidenceBps Int      @default(0)
  priority               Int      @default(100)
  metadata               String   @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([productId, active])
  @@index([supplierId, active])
  @@index([availability])
  @@index([priceVerifiedAt])
  @@index([priority])
}

model AffiliateProvider {
  id             String   @id @default(cuid())
  provider       String   @unique
  displayName    String
  trackingId     String   @default("")
  apiCredentials String   @default("{}")
  enabled        Boolean  @default(false)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClickEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  source    String   @default("web")
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model ImportJob {
  id           String   @id @default(cuid())
  provider     String
  status       String   @default("pending")
  itemsTotal   Int      @default(0)
  itemsSuccess Int      @default(0)
  itemsFailed  Int      @default(0)
  errorLog     String   @default("[]")
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
}

model ApiUsageLog {
  id        String   @id @default(cuid())
  provider  String
  endpoint String
  status    Int
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  source    String
  message   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model CacheEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ProductCandidate {
  id                   String   @id @default(cuid())
  asin                 String   @unique
  idempotencyKey       String   @unique
  sourceType           String
  sourceUrl            String?
  sourceObservedAt     DateTime @default(now())
  scout                String
  titleCandidate       String?
  brandCandidate       String?
  descriptionCandidate String?
  imagesCandidate      String   @default("[]")
  categoryCandidate    String?
  normalizedCategory   String?
  ownerSpecialLink     String?
  variationKey         String?
  state                String   @default("discovered")
  validationResult     String   @default("pending")
  validationDetail     String   @default("{}")
  classification       String?
  score                Float    @default(0)
  rejectionReason      String?
  duplicateOfId        String?
  attemptCount         Int      @default(0)
  maxAttempts          Int      @default(4)
  nextAttemptAt        DateTime?
  lastError            String?
  deadLetteredAt       DateTime?
  publishedProductId   String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([normalizedCategory])
  @@index([scout])
  @@index([variationKey])
  @@index([createdAt])
}

model ProductEngineWorkerState {
  id              String   @id @default(cuid())
  worker          String   @unique
  status          String   @default("idle")
  healthy         Boolean  @default(true)
  lastHeartbeatAt DateTime?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  processedCount  Int      @default(0)
  errorCount      Int      @default(0)
  lastError       String?
  updatedAt       DateTime @updatedAt
}

model ProductEngineConfig {
  id                  String   @id @default("default")
  paused              Boolean  @default(false)
  acceptanceThreshold Float    @default(70)
  categoryQuota       Int      @default(50)
  maxConcurrency      Int      @default(4)
  maxVariations       Int      @default(3)
  lastRunAt           DateTime?
  lastPublishedAt     DateTime?
  updatedAt           DateTime @updatedAt
}

model ProductEngineAudit {
  id          String   @id @default(cuid())
  candidateId String?
  actor       String
  action      String
  fromState   String?
  toState     String?
  detail      String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([candidateId])
  @@index([action])
  @@index([createdAt])
}

model Order {
  id                      String              @id @default(cuid())
  orderNumber             String              @unique
  checkoutKey             String              @unique
  userId                  String?
  email                   String
  currency                String              @default("usd")
  status                  String              @default("pending_payment")
  subtotalCents           Int
  shippingCents           Int                 @default(0)
  taxCents                Int                 @default(0)
  totalCents              Int
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?             @unique
  paidAt                  DateTime?
  canceledAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  items                   OrderItem[]
  payments                Payment[]
  refunds                 Refund[]
  procurementIntents      ProcurementIntent[]
  destination             OrderDestination?

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

model OrderDestination {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source             String   @default("stripe_checkout")
  providerSessionId  String   @unique
  sourceEventId      String
  recipientName      String
  line1              String
  line2              String?
  city               String
  state              String?
  postalCode         String
  country            String
  capturedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([country, capturedAt])
  @@index([sourceEventId])
}

model OrderItem {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  productSlug       String
  title             String
  quantity          Int
  unitPriceCents    Int
  lineTotalCents    Int
  landedCostCents   Int?
  supplierSnapshot  String             @default("{}")
  createdAt         DateTime           @default(now())
  procurementIntent ProcurementIntent?

  @@index([orderId])
  @@index([productId])
}

model ProcurementIntent {
  id                     String             @id @default(cuid())
  idempotencyKey         String             @unique
  orderId                String
  order                  Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId            String             @unique
  orderItem              OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  status                 String             @default("awaiting_review")
  executionMode          String             @default("manual_only")
  supplierSnapshot       String
  quantity               Int
  expectedUnitCostCents  Int?
  expectedTotalCostCents Int?
  currency               String
  blockedReason          String?
  approvedByUserId       String?
  approvedAt             DateTime?
  supplierOrderReference String?
  actualTotalCostCents   Int?
  executedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime            @updatedAt
  events                 ProcurementEvent[]

  @@index([orderId, status])
  @@index([status, createdAt])
}

model ProcurementEvent {
  id                  String            @id @default(cuid())
  eventKey            String            @unique
  procurementIntentId String
  procurementIntent   ProcurementIntent @relation(fields: [procurementIntentId], references: [id], onDelete: Cascade)
  type                String
  actor               String
  detail              String            @default("{}")
  createdAt           DateTime          @default(now())

  @@index([procurementIntentId, createdAt])
  @@index([type, createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("stripe")
  providerPaymentId String   @unique
  providerSessionId String?
  status            String
  amountCents       Int
  currency          String
  meta              String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  refunds           Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  type            String
  payloadSha256   String
  status          String    @default("processed")
  orderId         String?
  error           String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([orderId])
  @@index([type, receivedAt])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerRefundId String   @unique
  idempotencyKey   String   @unique
  amountCents      Int
  currency         String
  status           String
  reason           String?
  requestedBy      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

// Phase A savings ledger. Application code treats this model as append-only;
// PostgreSQL additionally enforces immutability with database triggers.
model SavingsFundEntry {
  id                String   @id @default(cuid())
  entryKey          String   @unique
  type              String
  orderId           String?
  refundId          String?
  amountCents       Int
  currency          String
  sourceProfitCents Int?
  policyVersion     String
  dryRun            Boolean  @default(true)
  metadata          String   @default("{}")
  createdAt         DateTime @default(now())

  @@index([currency, createdAt])
  @@index([type, createdAt])
  @@index([orderId, createdAt])
  @@index([refundId, createdAt])
  @@index([dryRun, createdAt])
}
