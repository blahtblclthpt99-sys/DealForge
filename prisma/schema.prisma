generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            String   @default("user")
  wishlist        String   @default("[]")
  savedSearches   String   @default("[]")
  recentlyViewed  String   @default("[]")
  priceAlerts     String   @default("[]")
  settings        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clicks          ClickEvent[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                 String   @id @default(cuid())
  asin               String?
  slug               String   @unique
  title              String
  description        String
  brand              String
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  subcategory        String?
  images             String
  quantity           Int?
  price              Float
  originalPrice      Float
  discountPercent    Float    @default(0)
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  affiliateUrl       String
  retailer           String   @default("amazon")
  availability       String   @default("in_stock")
  specifications     String   @default("{}")
  priceSource        String?
  priceVerifiedAt    DateTime?
  metadataSource     String?
  metadataVerifiedAt DateTime?
  trendingScore      Float    @default(0)
  clickCount         Int      @default(0)
  viewCount          Int      @default(0)
  isFeatured         Boolean  @default(false)
  isFlashDeal        Boolean  @default(false)
  flashEndsAt        DateTime?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  clicks ClickEvent[]

  @@index([categoryId])
  @@index([subcategory])
  @@index([asin])
  @@index([discountPercent])
  @@index([rating])
  @@index([trendingScore])
  @@index([createdAt])
  @@index([price])
  @@index([brand])
  @@index([isFeatured])
  @@index([isFlashDeal])
}

model AffiliateProvider {
  id             String   @id @default(cuid())
  provider       String   @unique
  displayName    String
  trackingId     String   @default("")
  apiCredentials String   @default("{}")
  enabled        Boolean  @default(false)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClickEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  source    String   @default("web")
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model ImportJob {
  id           String   @id @default(cuid())
  provider     String
  status       String   @default("pending")
  itemsTotal   Int      @default(0)
  itemsSuccess Int      @default(0)
  itemsFailed  Int      @default(0)
  errorLog     String   @default("[]")
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
}

model ApiUsageLog {
  id        String   @id @default(cuid())
  provider  String
  endpoint  String
  status    Int
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  source    String
  message   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model CacheEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ProductCandidate {
  id                   String   @id @default(cuid())
  asin                 String   @unique
  idempotencyKey       String   @unique
  sourceType           String
  sourceUrl            String?
  sourceObservedAt     DateTime @default(now())
  scout                String
  titleCandidate       String?
  brandCandidate       String?
  descriptionCandidate String?
  imagesCandidate      String   @default("[]")
  categoryCandidate    String?
  normalizedCategory   String?
  ownerSpecialLink     String?
  variationKey         String?
  state                String   @default("discovered")
  validationResult     String   @default("pending")
  validationDetail     String   @default("{}")
  classification       String?
  score                Float    @default(0)
  rejectionReason      String?
  duplicateOfId        String?
  attemptCount         Int      @default(0)
  maxAttempts          Int      @default(4)
  nextAttemptAt        DateTime?
  lastError            String?
  deadLetteredAt       DateTime?
  publishedProductId   String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([normalizedCategory])
  @@index([scout])
  @@index([variationKey])
  @@index([createdAt])
}

model ProductEngineWorkerState {
  id              String   @id @default(cuid())
  worker          String   @unique
  status          String   @default("idle")
  healthy         Boolean  @default(true)
  lastHeartbeatAt DateTime?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  processedCount  Int      @default(0)
  errorCount      Int      @default(0)
  lastError       String?
  updatedAt       DateTime @updatedAt
}

model ProductEngineConfig {
  id                  String   @id @default("default")
  paused              Boolean  @default(false)
  acceptanceThreshold Float    @default(70)
  categoryQuota       Int      @default(50)
  maxConcurrency      Int      @default(4)
  maxVariations       Int      @default(3)
  lastRunAt           DateTime?
  lastPublishedAt     DateTime?
  updatedAt           DateTime @updatedAt
}

model ProductEngineAudit {
  id          String   @id @default(cuid())
  candidateId String?
  actor       String
  action      String
  fromState   String?
  toState     String?
  detail      String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([candidateId])
  @@index([action])
  @@index([createdAt])
}
