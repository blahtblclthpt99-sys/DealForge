{
  "name": "dealforge",
  "version": "1.0.0",
  "private": true,
  "description": "DealForge — merchant-of-record deal commerce and sourcing platform",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "cf:build": "NEXT_PUBLIC_BUILD_SHA=${WORKERS_CI_COMMIT_SHA:-${GITHUB_SHA:-local}} CLOUDFLARE_WORKERS=1 opennextjs-cloudflare build",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "db:push:postgres": "prisma db push --schema=prisma/schema.postgres.prisma",
    "db:setup:postgres": "prisma db push --schema=prisma/schema.postgres.prisma",
    "db:reset:postgres": "node scripts/assert-destructive-seed.mjs && prisma db push --schema=prisma/schema.postgres.prisma && tsx prisma/seed.ts",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node scripts/assert-destructive-seed.mjs && tsx prisma/seed.ts",
    "db:setup": "prisma db push && npm run db:seed",
    "catalog:attach": "tsx scripts/attach-product-images.ts",
    "catalog:discover": "tsx scripts/discover-asins.ts && npm run db:seed",
    "catalog:links": "tsx scripts/validate-links.ts",
    "catalog:validate": "npm run catalog:links",
    "catalog:verify-affiliate": "tsx scripts/verify-affiliate.ts",
    "catalog:verify-prices": "tsx scripts/verify-prices.ts",
    "catalog:verify-structure": "tsx scripts/verify-catalog.ts",
    "catalog:health": "npm run catalog:verify-affiliate && npm run catalog:verify-prices && npm run catalog:verify-structure",
    "catalog:repair-images": "tsx scripts/repair-images.ts",
    "catalog:sync-images": "tsx scripts/sync-product-images.ts",
    "catalog:remove": "tsx scripts/remove-asins.ts",
    "catalog:refresh": "tsx scripts/attach-product-images.ts && npm run db:seed",
    "catalog:clothing": "tsx scripts/expand-clothing.ts",
    "catalog:refresh-prices": "tsx scripts/refresh-prices.ts",
    "ebay:enable": "tsx scripts/enable-ebay.ts",
    "test:price-alert-transitions": "tsx scripts/test-price-alert-transitions.ts",
    "test:pricing": "tsx --test tests/dynamic-pricing.test.ts",
    "test:commerce-core": "tsx --test tests/dynamic-pricing.test.ts tests/landed-cost.test.ts tests/commerce-eligibility.test.ts tests/direct-commerce-readiness.test.ts tests/commerce-source-binding.test.ts tests/commerce-runtime-safety.test.ts tests/order-access.test.ts tests/order-fulfillment.test.ts tests/commerce-display.test.ts",
    "worker": "tsx src/workers/index.ts",
    "website:package": "powershell -ExecutionPolicy Bypass -File scripts/package-website.ps1",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "latest",
    "@prisma/adapter-neon": "^6.16.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^3.0.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "latest",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "prisma": "^6.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "latest"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
