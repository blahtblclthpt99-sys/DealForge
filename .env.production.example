# DealForge production environment
# Configure these variables in the selected Node/Docker production host.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/dealforge?sslmode=require"

# Destructive reset protection. Leave empty for normal production operation.
# The seed command refuses production/non-local databases unless this exact confirmation
# is intentionally supplied: I_UNDERSTAND_DATA_WILL_BE_DELETED
ALLOW_DESTRUCTIVE_SEED=""

# Apply committed migrations before enabling commerce.
# Required in production. Generate at least 32 unpredictable characters with a CSPRNG.
# DealForge refuses to sign sessions when this is empty, short, or a known placeholder.
AUTH_SECRET=""
ADMIN_EMAIL="admin@dealforge.com"
# Used only by intentional seeding/bootstrap flows; do not use a default value.
ADMIN_PASSWORD=""

# Master payment kill switch.
# KEEP FALSE until Phase 2.5 Stripe transaction certification passes against production.
COMMERCE_ENABLED="false"

# Stripe — server only. Configure Stripe to deliver authoritative events to:
# https://www.deal-forge.sale/api/stripe/webhook
# The active STRIPE_SECRET_KEY determines which mode-specific webhook signing
# secret DealForge uses. Webhook secrets are endpoint-specific and test/live
# endpoints do not share the same whsec value.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET_TEST="whsec_test_endpoint_secret_here"
STRIPE_WEBHOOK_SECRET_LIVE="whsec_live_endpoint_secret_here"
# Legacy fallback only; leave empty when the mode-specific secrets are present.
STRIPE_WEBHOOK_SECRET=""

AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"

NEXT_PUBLIC_APP_URL="https://www.deal-forge.sale"
NEXT_PUBLIC_APP_NAME="DealForge"
