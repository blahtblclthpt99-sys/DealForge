# Production — set these in Koyeb service environment variables / Secrets.
# Hosted production uses the existing DealForge Neon PostgreSQL database.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-at-least-32-characters"

AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"

# Koyeb custom-domain target. Redirect the apex deal-forge.sale to www if needed.
NEXT_PUBLIC_APP_URL="https://www.deal-forge.sale"
NEXT_PUBLIC_APP_NAME="DealForge"

# Do not put seed/admin passwords in Koyeb. The existing Neon database is already
# initialized; production deploys must not reseed it.
