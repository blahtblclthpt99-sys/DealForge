# DealForge production environment
# Configure these variables in the selected Node/Docker production host.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/dealforge?sslmode=require"

# Destructive reset protection. Leave empty for normal production operation.
# The seed command refuses production/non-local databases unless this exact confirmation
# is intentionally supplied: I_UNDERSTAND_DATA_WILL_BE_DELETED
ALLOW_DESTRUCTIVE_SEED=""

# Apply committed migrations before enabling commerce.
# Required in production. Generate at least 32 unpredictable characters with a CSPRNG.
# DealForge refuses to sign sessions when this is empty, short, or a known placeholder.
AUTH_SECRET=""
# Recommended: provision a distinct 24+ character maintenance secret for internal cron calls.
# If omitted, DealForge derives a one-way maintenance credential from the validated AUTH_SECRET.
MAINTENANCE_TOKEN=""
# Required only for an intentional protected seed/bootstrap. Do not package defaults.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Keep disabled in production unless an isolated demo account is deliberately required.
SEED_DEMO_USER="false"
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""

# Master payment kill switch.
# KEEP FALSE until every remaining production commerce gate is certified and the separate
# code-level emergency commerce lock is deliberately removed.
COMMERCE_ENABLED="false"

# Production tax activation interlocks.
# These are NOT assertions that DealForge is currently tax-compliant. Keep both false until:
# 1) checkout actually enables/reconciles Stripe automatic tax end-to-end, and
# 2) the operator has completed the applicable registration/compliance review.
# Broad production commerce fails closed unless both values are exactly "true" after the
# separate code-level emergency commerce lock is deliberately removed.
STRIPE_AUTOMATIC_TAX_ENABLED="false"
TAX_COMPLIANCE_CERTIFIED="false"

# Physical-goods fulfillment destination interlocks.
# Start with an intentionally narrow country scope and expand only after supplier,
# returns, tax, and shipping operations are certified for each additional country.
# US shipping address collection + signed Checkout webhook persistence + immutable
# OrderDestination + manual-only procurement sequencing passed the production E2E gate
# on 2026-08-25 (workflow run 32916317169, source revision 03a9a1f2...).
CHECKOUT_ALLOWED_SHIPPING_COUNTRIES="US"
SHIPPING_ADDRESS_CAPTURE_CERTIFIED="true"

# Stripe — server only. Configure Stripe to deliver authoritative events to:
# https://www.deal-forge.sale/api/stripe/webhook
# The active STRIPE_SECRET_KEY determines which mode-specific webhook signing
# secret DealForge uses. Webhook secrets are endpoint-specific and test/live
# endpoints do not share the same whsec value.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET_TEST="whsec_test_endpoint_secret_here"
STRIPE_WEBHOOK_SECRET_LIVE="whsec_live_endpoint_secret_here"
# Legacy fallback only; leave empty when the mode-specific secrets are present.
STRIPE_WEBHOOK_SECRET=""

AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"

NEXT_PUBLIC_APP_URL="https://www.deal-forge.sale"
NEXT_PUBLIC_APP_NAME="DealForge"