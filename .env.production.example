# Production — configure these as hosted runtime variables/secrets.
# DealForge uses the existing Neon PostgreSQL production database.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-at-least-32-characters"

AMAZON_ASSOCIATE_TAG="titanfieldos-20"
AMAZON_PARTNER_TAG="titanfieldos-20"

# Amazon Creators API (OAuth 2.0). Keep credential values secret.
# Exact Amazon pricing is only displayed when refreshed through an approved source.
AMAZON_CREATORS_CREDENTIAL_ID=""
AMAZON_CREATORS_CREDENTIAL_SECRET=""
AMAZON_CREATORS_CREDENTIAL_VERSION="3.1"

# Google AdSense publisher/client ID and optional responsive ad-unit slots.
# ADSENSE_CLIENT must be a real AdSense value such as ca-pub-1234567890123456.
# A Google Ads customer ID (for buying ads) is NOT an AdSense publisher ID.
ADSENSE_CLIENT=""
ADSENSE_SLOT_HOME_TOP=""
ADSENSE_SLOT_HOME_FEED=""
ADSENSE_SLOT_PRODUCT=""

NEXT_PUBLIC_APP_URL="https://www.deal-forge.sale"
NEXT_PUBLIC_APP_NAME="DealForge"

# Production safety:
# - Do not set ALLOW_DESTRUCTIVE_SEED during normal deployment.
# - Do not set SEED_DEMO_USER in production.
# - prisma/seed.ts independently refuses a non-SQLite destructive seed unless
#   RESET_DEALFORGE_DATABASE plus explicit strong admin credentials are supplied.
# - Never commit production credentials or reseed the existing production database.
